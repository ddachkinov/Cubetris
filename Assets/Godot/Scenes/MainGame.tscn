; ─── Scene root ──────────────────────────────────────────────────────────────
[node name="MainGame" type="Node3D"]

; ─── World Environment ───────────────────────────────────────────────────────
; Gradient sky, bloom, glow, SSAO, color grading
[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_main")

; ─── Camera ──────────────────────────────────────────────────────────────────
; Position (0,9,-12), elevated view looking down at play field toward wall
; Better perspective for seeing stacking cubes building toward camera
[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(-1, 0, 0, 0, 0.9397, 0.342, 0, 0.342, -0.9397, 0, 9, -12)
current = true
fov = 80.0

; ─── Directional light ───────────────────────────────────────────────────────
; Shines from above-and-behind-camera toward the wall (bright daylight)
[node name="DirectionalLight3D" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.866, 0, -0.5, -0.433, 0.5, -0.75, 0.25, 0.866, 0.433, 0, 10, 0)
light_energy = 1.5
light_color = Color(1.0, 0.98, 0.92, 1.0)
shadow_enabled = true
shadow_bias = 0.05
shadow_blur = 1.5
directional_shadow_mode = 2
directional_shadow_split_1 = 0.1
directional_shadow_split_2 = 0.3
directional_shadow_split_3 = 0.6
directional_shadow_max_distance = 50.0

; ─── Ground plane ─────────────────────────────────────────────────────────────
[node name="Ground" type="StaticBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.1, 0)

[node name="MeshInstance3D" type="MeshInstance3D" parent="Ground"]
mesh = SubResource("BoxMesh_ground")
surface_material_override/0 = SubResource("Material_ground")
cast_shadow = 0

[node name="CollisionShape3D" type="CollisionShape3D" parent="Ground"]
shape = SubResource("BoxShape3D_ground")

; ─── Wall (AnimatableBody3D so physics registers movement) ───────────────────
; WallController.gd extends Node3D — valid to attach to AnimatableBody3D
; because AnimatableBody3D inherits from Node3D.
; Starts at Z=10; moves toward Z=-10 (game_over_z) during play.
; Height=2, centered at Y=1.0 (sits on ground at Y=0)
[node name="Wall" type="AnimatableBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 10)
script = ExtResource("1_wall")

[node name="MeshInstance3D" type="MeshInstance3D" parent="Wall"]
mesh = SubResource("BoxMesh_wall")
surface_material_override/0 = SubResource("Material_wall")

[node name="CollisionShape3D" type="CollisionShape3D" parent="Wall"]
shape = SubResource("BoxShape3D_wall")

; ─── Side Rails ──────────────────────────────────────────────────────────────
; Visual guides showing the playfield boundaries (like in reference image)
[node name="LeftRail" type="StaticBody3D" parent="."]
