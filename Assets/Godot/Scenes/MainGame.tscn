[node name="MeshInstance3D" type="MeshInstance3D" parent="LeftRail"]
mesh = SubResource("BoxMesh_rail")

[node name="CollisionShape3D" type="CollisionShape3D" parent="LeftRail"]
shape = SubResource("BoxShape3D_rail")

[node name="RightRail" type="StaticBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 6, 0.15, 0)

[node name="MeshInstance3D" type="MeshInstance3D" parent="RightRail"]
